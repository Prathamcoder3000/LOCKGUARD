# ==============================================================================
# LockGuard - Environment Configuration Template
# ==============================================================================
# Security Notice:
# 1. Do not commit actual credentials, private keys, or passwords to version control.
# 2. Copy this file to '.env' and provide environment-appropriate values.
# 3. In production, pass sensitive configuration via secret managers or secure environment variables.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development                # development | staging | production
APP_NAME=LockGuard
LOG_LEVEL=info                          # debug | info | warn | error
LOG_FORMAT=json                         # json | text

# --- HTTP Service Configuration ---
HTTP_PORT=8080
HTTP_HOST=0.0.0.0
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10

# --- Authentication & Security ---
AUTH_ENABLED=true
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES
JWT_EXPIRATION_HOURS=24
API_TOKEN_SALT=CHANGE_THIS_TO_SECURE_SALT

# --- PostgreSQL Configuration (Metadata, Auditing, Users, Benchmarks) ---
# Note: PostgreSQL does NOT store authoritative lock state or consensus logs.
DB_HOST=postgres
DB_PORT=5432
DB_USER=lockguard_user
DB_PASSWORD=lockguard_secure_password_replace_in_prod
DB_NAME=lockguard_db
DB_SSL_MODE=disable                     # disable | require | verify-full
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# --- Raft Consensus & Cluster Topology ---
# Node Identity: coordinator-a | coordinator-b | coordinator-c
NODE_ID=coordinator-a
RAFT_CLUSTER_NODES=coordinator-a:7000,coordinator-b:7000,coordinator-c:7000

# Raft Internal Bind & Peer Addresses (Private Raft network only)
RAFT_BIND_ADDR=0.0.0.0:7000
RAFT_ADVERTISE_ADDR=coordinator-a:7000
RAFT_HEARTBEAT_TIMEOUT_MS=1000
RAFT_ELECTION_TIMEOUT_MS=1000
RAFT_COMMIT_TIMEOUT_MS=50
RAFT_SNAPSHOT_INTERVAL_SECONDS=120
RAFT_SNAPSHOT_THRESHOLD=8192

# Coordinator Client API (Internal / Cluster-facing)
COORDINATOR_API_PORT=8001
COORDINATOR_API_HOST=0.0.0.0

# --- Storage Paths (Coordinator Independent Volumes) ---
DATA_DIR=/var/lib/lockguard/data
RAFT_LOG_STORE_PATH=/var/lib/lockguard/data/raft.db
RAFT_STABLE_STORE_PATH=/var/lib/lockguard/data/stable.db
RAFT_SNAPSHOT_STORE_PATH=/var/lib/lockguard/data/snapshots

# --- Lease & Fencing Configuration ---
DEFAULT_LEASE_TTL_SECONDS=10
MAX_LEASE_TTL_SECONDS=300
MIN_LEASE_TTL_SECONDS=1
FENCING_TOKEN_INITIAL=1000

# --- Protected Resource Service ---
PROTECTED_RESOURCE_PORT=9000
PROTECTED_RESOURCE_HOST=0.0.0.0
PROTECTED_RESOURCE_NAME=bank-ledger-service
PROTECTED_RESOURCE_HEALTH_INTERVAL_SECONDS=5

# --- Monitoring & Metrics ---
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=5

# --- Frontend Application ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=LockGuard Distributed Coordination

