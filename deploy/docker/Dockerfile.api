# Stage 1: Build binary
FROM golang:1.23-alpine AS builder

WORKDIR /build

# Copy module definitions
COPY backend/go.mod ./
# Download dependencies if any
RUN go mod download || true

# Copy backend source
COPY backend/ ./

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /lockguard-api ./cmd/api

# Stage 2: Final runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl tzdata

WORKDIR /app

COPY --from=builder /lockguard-api /app/lockguard-api

# Create non-root user
RUN addgroup -S lockguard && adduser -S lockguard -G lockguard && \
    mkdir -p /var/lib/lockguard/data && chown -R lockguard:lockguard /app /var/lib/lockguard

USER lockguard

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/lockguard-api"]

