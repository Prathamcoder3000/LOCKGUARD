# Stage 1: Build binary
FROM golang:1.23-alpine AS builder

WORKDIR /build

COPY protected-resource/go.mod ./
RUN go mod download || true
COPY protected-resource/ ./

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /lockguard-protected-resource ./cmd/main.go

# Stage 2: Final runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl tzdata

WORKDIR /app

COPY --from=builder /lockguard-protected-resource /app/lockguard-protected-resource

RUN addgroup -S lockguard && adduser -S lockguard -G lockguard && \
    chown -R lockguard:lockguard /app

USER lockguard

EXPOSE 9000

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:9000/health || exit 1

ENTRYPOINT ["/app/lockguard-protected-resource"]

